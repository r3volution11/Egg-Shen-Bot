# Environment variables
.env

# Per-deployment web form config (real Guild ID) — see public/config.example.js
public/config.js

# Guild configurations (server-specific settings)
guild_configs/

# Guild statistics (server-specific stats)
guild_stats/

# Watch history (server-specific watch logs)
guild_watch_history/

# Surveys/polls (server-specific poll data)
guild_polls/

# Tournaments (server-specific tournament data)
guild_tournaments/

# Active timers (runtime state)
active_timers.json

# Pending event requests (runtime state)
pending_event_requests.json
pending_event_channel_selections.json

# Event request images (user-uploaded, runtime state)
event_request_images/

# Bot status quotes (runtime state, editable via /quotes-admin or
# /eggshen-config-quotes) and the pending quote-suggestion queue
# (/suggest-quote). The .test.json variants are per-test-file paths (see
# MOVIE_QUOTES_FILE/MOVIE_QUOTES_PENDING_FILE) used to avoid parallel Jest
# workers racing on the same real file.
movie_quotes.json
movie_quotes_pending.json
movie_quotes*.test.json
movie_quotes_pending*.test.json

# Real copies made from templates/ during setup (the templates themselves
# stay tracked — see templates/README.md)
/event_request_config.json
/.env.production-testing

# Playwright e2e output
/test-results/
/playwright-report/
/blob-report/

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo

# Design files
*.sketch
*.code-workspace
design/

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/

# Built web-page assets (Bootstrap CSS/JS compiled from public/scss/ +
# public/js-src/ by `npm run build:web` — see scripts/build-web-assets.js).
# This project's own deploy always rebuilds these; a self-hoster who just
# clones the repo gets a working, CI-maintained fallback build instead —
# see .github/workflows/build-web-fallback.yml.
public/css/bootstrap.min.css
public/js/bootstrap.min.js
# Regenerated by every build from WEB_PRIMARY_COLOR — never hand-edited.
public/scss/_generated-palette.scss
